# CA Guru bot environment — copy to .env and fill in. Every key here is read by src/config.js.

# ─── Required: the bot refuses to start without these ───────────────────────
OPENAI_API_KEY=
# This bot's OWN wacrm account and number — never the shared FOCAS account, where the
# Mentor server's MCQ bot answers every inbound and both bots would reply.
WACRM_BASE_URL=
WACRM_API_KEY=

# ─── Server ─────────────────────────────────────────────────────────────────
# Docker overrides HOST/PORT (0.0.0.0:3000, published on 127.0.0.1:3007).
HOST=127.0.0.1
PORT=3000
# Public https:// origin of this bot, used when registering the webhook.
PUBLIC_BASE_URL=https://guru-bot.focasedu.com
# Guards /admin/*. Blank = admin routes switched off. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Only for the docker-compose Caddy TLS profile.
PUBLIC_HOST=guru-bot.focasedu.com

# ─── WhatsApp (wacrm) ───────────────────────────────────────────────────────
WACRM_TIMEOUT_MS=15000
# Shown once by: npm run webhook:register
WACRM_WEBHOOK_SECRET=
WACRM_WEBHOOK_TOLERANCE_MS=300000
# SETUP ONLY: accept unsigned events until WACRM_WEBHOOK_SECRET is set (ignored after).
WACRM_WEBHOOK_ALLOW_UNSIGNED=false
# Optional: append every raw webhook to this file while setting up.
WEBHOOK_CAPTURE_FILE=

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Optional: only if routing through a proxy/gateway. Blank = api.openai.com.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Blank = mongodb://127.0.0.1:27017
MONGO_URL=
# Never CA-Guru-Ai (the product database) — startup rejects it.
MONGO_DB=CA-Guru-bot

# ─── Bot behaviour ──────────────────────────────────────────────────────────
BOT_NAME=CA Guru
# Comma-separated numbers with country code, e.g. 919876543210,919812345678.
# Non-empty = ONLY these numbers get replies. Keep your team's phones here until go-live.
BOT_ALLOWLIST=
# The bot answers a contact only after they send this phrase (anywhere in a message, any case);
# from then on it answers everything they send. Everyone else is left to the team.
# Blank = answer every contact.
BOT_TRIGGER_PHRASE=YOUR LAST ATTEMPT
BOT_MAX_MESSAGES_PER_HOUR=30
# New leads (first trigger phrase) answer a few qualifying questions, then get this link to
# the Jan 27 chances calculator. Blank = the message goes out without a link.
CALCULATOR_URL=
# CALCULATOR_MESSAGE=
# An unfinished questionnaire left silent this long is dropped.
FLOW_EXPIRY_HOURS=24
HISTORY_TURNS=6
HISTORY_HOURS=24
HANDOVER_HOURS=12
STAFF_CONFIRM_MS=5000

# ─── Knowledge base ─────────────────────────────────────────────────────────
# auto = embeddings with keyword fallback; lexical = keywords only.
KB_SEARCH_MODE=auto
KB_DIR=knowledge
KB_CACHE_FILE=data/embeddings.json
KB_TOP_K=5
KB_MIN_SCORE=0.3

# ─── Message texts (optional) ───────────────────────────────────────────────
# Leave commented out to use the built-in defaults — a blank value sends an empty message.
# WELCOME_MESSAGE=
# HANDOVER_MESSAGE=
# MEDIA_MESSAGE=
# OPT_OUT_MESSAGE=
# OPT_IN_MESSAGE=
